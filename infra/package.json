{
    "name": "@vestiq/infra",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "typecheck": "tsc -p tsconfig.json",
        "synth": "cdk synth --quiet",
        "diff": "cdk diff --all",
        "deploy": "cdk deploy --all",
        "deploy:dev": "cdk deploy --all -c stage=dev",
        "deploy:prod": "cdk deploy --all -c stage=prod",
        "destroy": "cdk destroy --all",
        "bootstrap": "cdk bootstrap",
        "test": "vitest run",
        "test:watch": "vitest",
        "cdk": "cdk"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "aws-cdk": "2.1145.0",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.0",
        "vitest": "^5.0.4"
    },
    "dependencies": {
        "aws-cdk-lib": "^2.272.0",
        "constructs": "^10.5.0"
    }
}
